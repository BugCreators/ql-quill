{
  "name": "ql-quill",
  "version": "2.1.0",
  "description": "A wrapper for quill",
  "main": "./dist/ql-quill.cjs.js",
  "module": "./dist/ql-quill.es.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ql-quill.es.mjs",
      "require": "./dist/ql-quill.cjs.js",
      "default": "./dist/ql-quill.cjs.js"
    },
    "./dist/*": "./dist/*",
    "./locale/*.js": "./locale/*.js",
    "./locale/*": "./locale/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "locale/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "npm run build:locale && npm run build:lib",
    "build:locale": "node scripts/build-locale.mjs",
    "build:lib": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs --dist",
    "check:syntax": "node --experimental-vm-modules scripts/check-artifact-syntax.mjs",
    "verify": "node scripts/verify-package.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BugCreators/ql-quill.git"
  },
  "keywords": [
    "ql-quill"
  ],
  "license": "MIT",
  "homepage": "https://github.com/BugCreators/ql-quill",
  "engines": {
    "node": ">=16"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^20.19.0 || >=22.12.0",
      "onFail": "error"
    }
  },
  "peerDependencies": {
    "quill": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@enzedonline/quill-blot-formatter2": "^3.2.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/extend": "^3.0.4",
    "@types/node": "^22.20.5",
    "extend": "^3.0.2",
    "playwright": "^1.65.0",
    "publint": "^0.3.25",
    "quill": "^2.0.3",
    "quill-better-table": "^1.2.10",
    "rollup-plugin-typescript2": "^0.37.0",
    "stylus": "^0.64.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "browserslist": [
    "> 0.5%",
    "not dead"
  ]
}
