{
  "name": "ql-quill",
  "version": "2.0.5",
  "description": "A wrapper for quill",
  "main": "./dist/ql-quill.cjs.js",
  "module": "./dist/ql-quill.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "locale/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "npm run build:locale && npm run build:lib",
    "build:locale": "node scripts/build-locale.mjs",
    "build:lib": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs --dist",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BugCreators/ql-quill"
  },
  "keywords": [
    "ql-quill"
  ],
  "license": "MIT",
  "homepage": "https://github.com/BugCreators/ql-quill",
  "engines": {
    "node": "^14.18.0 || >=16.0.0"
  },
  "dependencies": {
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.18.2",
    "@babel/preset-env": "^7.18.2",
    "@enzedonline/quill-blot-formatter2": "^3.2.0",
    "@rollup/plugin-babel": "^5.3.1",
    "@types/babel__core": "^7.1.19",
    "@types/extend": "^3.0.1",
    "@types/node": "^18.7.13",
    "extend": "^3.0.2",
    "playwright": "^1.65.0",
    "quill-better-table": "^1.2.10",
    "rollup-plugin-typescript2": "^0.33.0",
    "stylus": "^0.54.8",
    "typescript": "^4.7.4",
    "vite": "^2.9.15",
    "vite-plugin-dts": "^1.7.0"
  },
  "browserslist": [
    "> 0.5%",
    "not dead"
  ]
}
