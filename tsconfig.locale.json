{
  "//": "语言包单独构建（build/rollup.config.ts 使用），产出 locale/*.js 与 .d.ts",
  "compilerOptions": {
    "target": "es5",
    "allowJs": true,
    "outDir": "./locale",
    "rootDir": "./src/locale",
    "declaration": true,
    "declarationDir": "./locale",
    "moduleResolution": "node",
    "types": ["node", "vite/client", "babel__core"],
    "baseUrl": "./"
  },
  "include": ["./src/locale"]
}
